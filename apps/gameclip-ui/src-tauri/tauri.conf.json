{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameClip",
  "version": "0.1.0",
  "identifier": "io.github.poldion.GameClip",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GameClip",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; media-src 'self' http://clip.localhost; img-src 'self' http://clip.localhost data:; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"]
  }
}
